+         // than only when it has reached zero -- otherwise the tint drops out for a frame each
+         // time the countdown runs down.
+         if (this.dataSync.getObjectByte(9) != 0) {
+            this.freeze = 2;
+         } else if (this.freeze > 0) {
+            this.freeze = 0;
+         }
+      } else {
+         byte want = (byte)(this.freeze > 0 ? 1 : 0);
+         if (this.dataSync.getObjectByte(9) != want) {
+            this.dataSync.updateObject(9, want);
+         }
+      }
    }
 
