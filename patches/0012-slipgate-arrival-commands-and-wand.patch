+   /**
+    * Put a just-transferred player somewhere survivable, and where they expect to be.
+    *
+    * Slipgates generate in both worlds -- a pit in the overworld, a shaft through the ceiling in
+    * hell -- so falling through one should land you at the hell gate, not at the matching
+    * coordinates. Ask the destination world for its nearest slipgate and aim there.
+    *
+    * Height is found by scanning DOWNWARD. getTopSolidTile is useless here: it returns the
+    * highest solid block, and hell's roof is a solid slab across the top of the world, so it
+    * always answers "the roof" and drops the player on top of everything.
+    */
+   private void placeInDestination(EntityPlayerMP player, int entryX, int entryY, int entryZ) {
+      WorldServer world = this.mcServer.getWorldManager(player.dimension);
+      int x = entryX;
+      int z = entryZ;
+
+      // Remembered before anything overwrites them. The arrival used to log only where the
+      // player ended up, which is the least useful number when the placement went somewhere
+      // unexpected: a fallback to world spawn looks identical to a slipgate that was found.
+      int fromX = x;
+      int fromZ = z;
+      boolean usedSpawn = false;
+
+      BlockPosition gate = null;
+      String gateFailure = null;
+      try {
+         gate = world.findClosestStructure(Slipgate.class, x, entryY, z);
+      } catch (Throwable t) {
+         // Never swallow this. The lookup walks worldgen structures for a dimension that may
+         // not have generated yet, so it is exactly the call most likely to throw -- and a
+         // silent catch here turns "the lookup crashed" into "there was no gate", which are
+         // very different problems and look identical in the log.
+         gateFailure = t.getClass().getName() + ": " + t.getMessage();
+         logger.log(java.util.logging.Level.WARNING, "slipgate lookup failed in dimension "
+            + player.dimension + " at " + x + "," + z, t);
+      }
+
+      logger.info("[slipgate] dim=" + player.dimension + " from=" + x + "," + z
+         + " chunk=" + (x >> 4) + "," + (z >> 4)
+         + " -> " + (gate != null ? "found at " + gate.x + "," + gate.z
+                                  : gateFailure != null ? "LOOKUP THREW (" + gateFailure + ")"
+                                                        : "no slipgate within 10 chunks"));
+
+      if (gate != null) {
+         x = gate.x;
+         z = gate.z;
+      }
+
+      world.chunkProviderServer.loadChunk(x >> 4, z >> 4);
+
+      // Arriving at a slipgate should put you IN it, standing in the shaft, so the way back is
+      // the thing you are looking at rather than something to go hunting for.
+      //
+      // Only in the Crimson. Its slipgate is a shaft through the roof, so the shaft floor is a
+      // place to stand. The overworld's is a pit carved through the bedrock floor, and dropping
+      // someone into that would put them straight back through the bottom of the world and into
+      // the Crimson again -- an arrival loop. Overworld arrivals keep using ground level.
+      boolean atShaft = false;
+      boolean atPocket = false;
+      int y = -1;
+      if (gate != null && player.dimension == 1) {
+         y = findSlipgateShaftFooting(world, x, z);
+         atShaft = y > 0;
+      } else if (gate != null) {
+         // Everywhere except the Crimson, a slipgate is a pit carved through the floor with
+         // nothing under it -- you cannot be placed IN one, you would drop straight back out of
+         // the world. But the outer ring is standing room: Slipgate.generate clears y8-16 there
+         // and leaves a partial netherrack floor below, so that ring is where an arrival belongs.
+         int[] spot = findSlipgatePocketFooting(world, x, z);
+         if (spot != null) {
+            x = spot[0];
+            y = spot[1];
+            z = spot[2];
+            atPocket = true;
+         }
+      }
+
+      if (y < 0) {
+         y = findFootingBelowRoof(world, x, z);
+      }
+
+      if (y < 0) {
+         usedSpawn = true;
+         Position spawn = world.getSpawnPoint();
+         x = spawn.x;
+         z = spawn.z;
+         world.chunkProviderServer.loadChunk(x >> 4, z >> 4);
+         y = findFootingBelowRoof(world, x, z);
+         if (y < 0) {
+            y = spawn.y;
+         }
+      }
+
+      player.fallDistance = 0.0F;
+      player.motionY = 0.0;
+      player.setPosition(x + 0.5, y, z + 0.5);
+      this.teleportTo(x + 0.5, y, z + 0.5, player.yaw, player.pitch);
+
+      // The arriving entity is a fresh object, so give it its own grace period rather than
+      // trusting the cooldown from the one that walked into the gate.
+      player.portalCooldown = PORTAL_GRACE_TICKS;
+
+      logger.info(
+         player.username + " arrived in dimension " + player.dimension + " at " + x + "," + y + "," + z
+            + " [entered from " + fromX + "," + fromZ + "]"
+            + (atShaft
+               ? " (in the slipgate shaft)"
+               : atPocket
+               ? " (in the slipgate pocket)"
+               : gate != null
+                  ? " (slipgate found, but no shaft here -- ground level)"
+                  : usedSpawn
+                     ? " (no slipgate within 160 blocks AND no footing -- fell back to this dimension's spawn)"
+                     : " (no slipgate within 160 blocks -- ground level under the entry point)")
+      );
+   }
