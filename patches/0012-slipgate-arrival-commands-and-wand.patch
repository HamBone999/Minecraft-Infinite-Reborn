+   /** Land at a point the caller already knows is good, loading its chunk first. */
+   private void arriveAt(EntityPlayerMP player, double x, double y, double z) {
+      WorldServer world = this.mcServer.getWorldManager(player.dimension);
+      world.chunkProviderServer.loadChunk(MathHelper.floor_double(x) >> 4, MathHelper.floor_double(z) >> 4);
+      player.fallDistance = 0.0F;
+      player.motionY = 0.0;
+      player.setPosition(x, y, z);
+      this.teleportTo(x, y, z, player.yaw, player.pitch);
+   }
+
+   /**
+    * Standing room in the ring around a slipgate, for the dimensions where the gate is a pit.
+    *
+    * Slipgate.generate carves two radii. The inner one (within 6 blocks) is cleared all the way
+    * through the floor -- that is the hole you fall down, and there is nothing to stand on in
+    * it. The outer one (within 12) only clears y8-16 and leaves a scatter of netherrack below,
+    * so the ring around the hole is a room with a floor.
+    *
+    * Searching that ring and preferring the column nearest the centre puts an arrival beside
+    * the gate, looking at it, rather than in it.
+    *
+    * Returns {x, y, z}, or null if the ring has no footing -- the floor is generated with a coin
+    * flip per column, so some of it is holes.
+    */
+   private int[] findSlipgatePocketFooting(WorldServer world, int centreX, int centreZ) {
+      int[] best = null;
+      int bestDist = Integer.MAX_VALUE;
+
+      for (int dx = -11; dx <= 11; dx++) {
+         for (int dz = -11; dz <= 11; dz++) {
+            int dist = dx * dx + dz * dz;
+            if (dist <= Slipgate.radiusInnerSquared || dist >= Slipgate.radiusSquared || dist >= bestDist) {
+               continue;
+            }
+
+            int x = centreX + dx;
+            int z = centreZ + dz;
+            if (!world.blockExists(x, 1, z)) {
+               continue;
+            }
+
+            for (int y = 15; y >= 1; y--) {
+               if (world.getBlockId(x, y, z) == 0
+                  && world.getBlockId(x, y + 1, z) == 0
+                  && world.getBlockId(x, y - 1, z) != 0) {
+                  best = new int[] { x, y, z };
+                  bestDist = dist;
+                  break;
+               }
+            }
+         }
+      }
+
+      return best;
+   }
+
+   /**
+    * Standing room on the floor of a slipgate's shaft, in the roof of the Crimson.
+    *
+    * Slipgate.generate carves the shaft out of the top of the world -- the wide part from
+    * worldHeight-16 upward and the narrow column right through to worldHeight-1 -- so the shaft
+    * has a floor made of the roof itself. Scanning down through the roof band and keeping the
+    * LOWEST air block that still has something solid under it lands on that floor: the top of
+    * the shaft is open sky, and only its base has footing.
+    *
+    * Returns -1 for a column with no shaft, which is every column except a slipgate.
+    */
+   private int findSlipgateShaftFooting(WorldServer world, int x, int z) {
+      int floor = -1;
+      int bottom = world.getWorldHeight() - 32;
+
+      for (int y = world.getWorldHeight() - 2; y > bottom && y > 1; y--) {
+         if (world.getBlockId(x, y, z) == 0
+            && world.getBlockId(x, y + 1, z) == 0
+            && world.getBlockId(x, y - 1, z) != 0) {
+            floor = y;
+         }
+      }
+
+      return floor;
+   }
+
+   /** Lowest y with solid ground and two air blocks above, searching down from below the roof. */
+   private int findFootingBelowRoof(WorldServer world, int x, int z) {
+      // Start below the solid roof slab rather than at the very top, so the first hit is real
+      // terrain and never the underside of the ceiling. Measured in DIM1: roof occupies the top
+      // 16 layers, y176-287 is empty air, and the ground players want is y0-175.
+      int top = world.getWorldHeight() - 24;
+      if (top > 176) {
+         top = 176;
+      }
+
+      for (int y = top; y > 4; y--) {
+         if (world.getBlockId(x, y, z) != 0 && world.getBlockId(x, y + 1, z) == 0 && world.getBlockId(x, y + 2, z) == 0) {
+            return y + 1;
+         }
+      }
+
+      return -1;
+   }
