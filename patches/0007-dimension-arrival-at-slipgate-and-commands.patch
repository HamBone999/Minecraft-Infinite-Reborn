    private void handleSlashCommand(String var1) {
+      // Built-in extras (homes, warps, tpa, msg...). They run before the vanilla dispatcher and
+      // only consume what they actually handle, so unknown commands still reach it normally.
+      if (net.minecraft.commands.custom.ServerCommands.handle(this.playerEntity, this.mcServer, var1)) {
+         return;
+      }
       this.mcServer.addCommand(var1.substring(1).trim(), this::createCommandSource);
