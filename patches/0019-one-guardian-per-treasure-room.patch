+   /**
+    * Whether this treasure room already has its guardian.
+    *
+    * hasSpawnedBoss cannot answer that on its own. It is a plain field on the structure piece
+    * and is never written to NBT, so every time the piece is rebuilt -- a reload, a re-read of
+    * the structure data -- it comes back false and the room spawns a second guardian on top of
+    * the first. Players reported three at once, each with its own boss bar, and some of them
+    * invisible to one player but not the other, which is what a stack of duplicates looks like.
+    *
+    * Asking the world is the reliable question, because the answer survives whatever happened to
+    * the piece in between. A generous box: spawning no guardian when one is already there is a
+    * far cheaper mistake than spawning another.
+    */
+   private static boolean guardianAlreadyHere(World world, double x, double y, double z) {
+      return !world.getEntitiesOfType(
+            Guardian.class,
+            BoundingBox.getBoundingBox(x - 32.0, y - 24.0, z - 32.0, x + 32.0, y + 24.0, z + 32.0)
+         )
+         .isEmpty();
+   }
